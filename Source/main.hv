
PointType := class
{
	pos := vec2f
	velocity := vec2f

	"=" := default
}

main := !(char^[] args) -> int
{
	x := 800
	y := 800

	g := EngTools
	g.Init()

	win := g.window

	vk := g.vk

	shadersDB := ref g.shadersDB

	renderPass := vk.CreateRenderPass(![
			TRenderPassFrame(vk.SwapImageFormat, VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR)
		],false)

	ctx := GameContext

	ctx.pointsCount = 32*1024

	vk.initCreateStageMemory()

	g.CreateGlobalBuffer("Particles",ctx.pointsCount*PointType->TypeSize,"vsr")
	points := g.GlobalBufferAsModel("Particles",PointType)

	ctx.vertData = g.vertStorage

	{
		verts := Vector.{PointType}
		verts.Resize(ctx.pointsCount)
		defer verts.Destroy()

		for it : verts
		{
			it.pos.x = RandInt(0..1000) / 1000 - 0.5
			it.pos.y = RandInt(0..1000) / 1000 - 0.5
			it.pos *= vec2f(2.0,2.0)
		}
		ctx.vertData.TransferData(verts)
	}

	layout := renderPass.CreateLayout(PointType,![],![],resultImageCount = 1,topology = "Points")

	shadersDB.SetInput("light",layout)

	ctx.mainShader = shadersDB.LoadShader("ShadersBin/test.json")

	mouseMoveShader := g.LoadComputeShader("ShadersBin/MouseMove.comp")
	moveShader := g.LoadComputeShader("ShadersBin/Move.comp")

	g.Hack()

	cmds := TVkCommandBuffer(vk,vk.itDrawCmdPool2)

	g.PrepareMainLoop()
	while not g.ShouldClose()
	{
		g.AsyncStartDrawing()

		cmds.Reset()
		cmds.Start()

		if buttons['q'] or MouseButtons[0]
			g.ExecuteComputeShader(cmds,mouseMoveShader,ctx.pointsCount)
		g.ExecuteComputeShader(cmds,moveShader,ctx.pointsCount)

		g.StartDrawing(cmds)
		g.DrawPoints(cmds,points)
		DrawParticles(vk,ctx,cmds,g.currentIndex,x,y,g)
		g.EndDrawing(cmds)


		cmds.Stop()
		cmds.Submit(vk.DrawQueue,null)
		vk.Funcs.vkQueueWaitIdle(vk.DrawQueue)

		g.StopDrawing()
	}
	win.DestroyWindow()
	return 0
}
